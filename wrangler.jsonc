{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "test-docs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Must match "name" above
      "binding": "WORKER_SELF_REFERENCE",
      "service": "test-docs"
    }
  ],
  // next/image optimization (MDX images are imported locally and rendered through next/image)
  "images": {
    "binding": "IMAGES"
  },
  // Per-visitor limit for Ask AI (/api/chat); AgentConnect only caps concurrent turns per conversation
  "ratelimits": [
    {
      "name": "ASK_AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
